---
import StarlightSearch from '@astrojs/starlight/components/Search.astro';

const pathname = Astro.url.pathname;

if (pathname === '/zh' || pathname.startsWith('/zh/')) {
  const translations: Record<string, string> = {
    'search.label': '搜索',
    'search.ctrlKey': 'Ctrl',
    'search.cancelLabel': '取消',
    'search.devWarning': '搜索仅适用于生产版本。\n请构建并预览网站以在本地测试。',
    'pagefind.clear_search': '清除',
    'pagefind.load_more': '加载更多结果',
    'pagefind.search_label': '搜索本站',
    'pagefind.filters_label': '筛选',
    'pagefind.zero_results': '未找到与“[SEARCH_TERM]”相关的结果',
    'pagefind.many_results': '找到 [COUNT] 个与“[SEARCH_TERM]”相关的结果',
    'pagefind.one_result': '找到 [COUNT] 个与“[SEARCH_TERM]”相关的结果',
    'pagefind.alt_search': '未找到与“[SEARCH_TERM]”相关的结果，改为显示“[DIFFERENT_TERM]”的结果',
    'pagefind.search_suggestion': '未找到与“[SEARCH_TERM]”相关的结果，请尝试以下搜索：',
    'pagefind.searching': '正在搜索“[SEARCH_TERM]”……',
  };
  const baseTranslate = Astro.locals.t;
  Astro.locals.t = new Proxy(baseTranslate, {
    apply(target, thisArg, args) {
      const [key] = args;
      return typeof key === 'string' && key in translations
        ? translations[key]
        : Reflect.apply(target, thisArg, args);
    },
    get(target, property, receiver) {
      return property === 'all'
        ? () => ({ ...baseTranslate.all(), ...translations })
        : Reflect.get(target, property, receiver);
    },
  });
}
---

<StarlightSearch {...Astro.props} />
